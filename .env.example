# Puntr environment variables. Placeholders only: never commit real values.
# Server-only values go in Vercel (Production and Preview) and are never prefixed with VITE_.

# --- Supabase (public, safe in the browser) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Supabase (server only) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cron (server only). The same value is stored in Supabase Vault as `cron_secret`. ---
CRON_SECRET=

# --- Content engine (server only). See docs/CONTENT_ENGINE.md ---
# Google AI Studio key from a project with NO billing account attached (free tier only).
GEMINI_API_KEY=
# Parallel Search key (platform.parallel.ai). Needed for sports articles.
PARALLEL_API_KEY=
# Firecrawl key (firecrawl.dev). Optional: without it the engine uses search excerpts only.
FIRECRAWL_API_KEY=
# Optional. Ordered list, primary first. Models outside the free list in src/lib/content/config.ts are refused.
CONTENT_GEMINI_MODELS=gemini-3.8-flash,gemini-3.1-flash-lite
# Optional. The engine's own requests-per-day ceiling per model: copy the limits shown in Google AI Studio.
CONTENT_GEMINI_RPD=
# Optional. Time budget for one run in milliseconds (default 50000).
CONTENT_RUN_BUDGET_MS=

# --- Fixtures and results (server only). See docs/PFIE_INTEGRATION.md ---
# `pfie` = Parallel Search + Gemini (uses GEMINI_API_KEY and PARALLEL_API_KEY above). Leave empty for API-Sports.
SPORTS_PROVIDER=
# Optional. Extraction model order; the lite model first because it has the larger free daily allowance.
PFIE_GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash
# Only for the API-Sports adapter.
SPORTS_API_KEY=
SPORTS_LEAGUE_IDS=
SPORTS_ENABLED=soccer
